{
  "name": "@bluebulu998/dsh-skill-manager",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "description": "Cross-session skill manager page: lists filesystem-scanned skills by source, toggles SKILL.md invocation frontmatter, and shows scan roots.",
  "license": "MIT",
  "author": "Bluebulu998",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bluebulu998/dsh-skill-manager.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bundle",
    "skill",
    "skill-manager",
    "frontmatter"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts/build.mjs",
    "scripts/probe-local.mjs",
    "scripts/pack.mjs",
    "scripts/test-*.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-host.mjs && node scripts/test-fallback.mjs && node scripts/test-references.mjs && node scripts/test-frontmatter.mjs && node scripts/test-client.mjs && node scripts/test-page.mjs && node scripts/build.mjs",
    "pack": "node scripts/pack.mjs",
    "probe": "node scripts/probe-local.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}